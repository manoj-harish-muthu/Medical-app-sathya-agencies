# ==============================================================================
# PharmaERP Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your .env file containing real secrets to version control!
# ==============================================================================

# ==============================================================================
# 1. Hosted Neon DB (Cloud PostgreSQL) Connection
# ==============================================================================
# Paste your Neon DB connection string or JDBC URL here.
# Accepts both raw PostgreSQL URI and JDBC formats:
# Example:
#   NEON_DB_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#   or
#   NEON_DB_URL=jdbc:postgresql://ep-cool-cloud-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
# (When NEON_DB_URL is set, it takes priority over local MySQL settings below)
NEON_DB_URL=

# ==============================================================================
# 2. Local Database Connection Settings (MySQL)
# ==============================================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=pharmacy_erp
DB_USER=root
DB_PASSWORD=manojmagesh

# Optional: Override full JDBC URL directly for local DB
# DB_URL=jdbc:mysql://localhost:3306/pharmacy_erp?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true

# HikariCP Connection Pool Settings
DB_POOL_SIZE=10

# Security / Demo Mode (Set to true only for local testing without DB auth)
ALLOW_DEMO_LOGIN=false
