<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.PurchaseReturnController" styleClass="root" stylesheets="@../css/style.css">
    
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Purchase Return Entry" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="New Return" style="-fx-font-weight: bold; -fx-text-fill: #b91c1c; -fx-font-size: 14px;"/>
            </HBox>
            
            <!-- Supplier and Details -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Select Supplier" styleClass="form-label"/>
                    <ComboBox fx:id="cmbSupplier" maxWidth="Infinity" promptText="-- Select Supplier --"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Original Invoice No" styleClass="form-label"/>
                    <TextField fx:id="txtInvoiceNo" promptText="Invoice No."/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Return Date" styleClass="form-label"/>
                    <DatePicker fx:id="dpReturnDate" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Reason" styleClass="form-label"/>
                    <ComboBox fx:id="cmbReason" maxWidth="Infinity" promptText="Expired"/>
                </VBox>
            </HBox>
            
            <!-- Return Table -->
            <TableView fx:id="tblCart" VBox.vgrow="ALWAYS" minHeight="200" editable="true">
                <columns>
                    <TableColumn fx:id="colMedicine" text="Medicine" prefWidth="250">
                        <cellValueFactory><PropertyValueFactory property="medicineName"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colBatch" text="Batch" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="batchNumber"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colQty" text="Return Qty" prefWidth="100">
                        <cellValueFactory><PropertyValueFactory property="quantity"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colRate" text="Pur. Rate (₹)" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="purchaseRate"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colTotal" text="Return Amount" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="netAmount"/></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            
            <!-- Totals & Actions -->
            <HBox spacing="20" alignment="CENTER_RIGHT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                
                <Label text="Total Items:" styleClass="form-label"/>
                <Label fx:id="lblTotalItems" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <Region prefWidth="30"/>
                
                <Label text="Grand Total (₹):" styleClass="form-label"/>
                <Label fx:id="lblGrandTotal" text="0.00" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #15803d;"/>
                
                <Region prefWidth="30"/>
                
                <Button text="Cancel" styleClass="button-outline" onAction="#handleDashboard"/>
                <Button text="Save Return" styleClass="button-primary" onAction="#handleSaveReturn" prefHeight="40" prefWidth="150" style="-fx-font-size: 16px;"/>
            </HBox>
            
        </VBox>
    </center>
</BorderPane>
