<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.AgentOrdersController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="16">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            
            <!-- Top Header Bar -->
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Button text="← Back to Dashboard" onAction="#handleDashboard" styleClass="button-outline"/>
                <VBox spacing="2">
                    <Label text="WhatsApp AI Agent Orders" styleClass="page-title"/>
                    <Label fx:id="countLabel" text="Loading incoming orders from WhatsApp..." styleClass="secondary-text"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Refresh Orders" onAction="#handleRefresh" styleClass="button-primary"/>
            </HBox>

            <!-- Search and Filter Bar -->
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="card" style="-fx-padding: 10 16;">
                <TextField fx:id="searchField" promptText="🔍 Search by customer name, phone, address, or medicine..." 
                           styleClass="text-field" prefWidth="380" HBox.hgrow="ALWAYS"/>
                <Separator orientation="VERTICAL"/>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Button fx:id="btnFilterAll" text="All Orders" onAction="#handleFilterAll" styleClass="button-tender" style="-fx-font-weight: 800;"/>
                    <Button fx:id="btnFilterPending" text="Pending Review" onAction="#handleFilterPending" styleClass="button-tender"/>
                    <Button fx:id="btnFilterApproved" text="Approved" onAction="#handleFilterApproved" styleClass="button-tender"/>
                    <Button fx:id="btnFilterPacking" text="Packing / Shipped" onAction="#handleFilterPacking" styleClass="button-tender"/>
                </HBox>
            </HBox>

            <!-- Master-Detail SplitPane -->
            <SplitPane dividerPositions="0.58" VBox.vgrow="ALWAYS" styleClass="split-pane">
                
                <!-- Left: Master Orders Table -->
                <VBox spacing="10" styleClass="card" style="-fx-padding: 14;">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Customer Orders Queue" styleClass="section-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="tableStatsLabel" text="" styleClass="secondary-text" style="-fx-font-size: 11.5px;"/>
                    </HBox>
                    
                    <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colPhone" text="Customer Phone" prefWidth="120"/>
                            <TableColumn fx:id="colCustomer" text="Customer Name" prefWidth="135"/>
                            <TableColumn fx:id="colAddress" text="Delivery Address" prefWidth="180"/>
                            <TableColumn fx:id="colItemsCount" text="Items" prefWidth="60" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colItems" text="Medicines Ordered" prefWidth="190"/>
                            <TableColumn fx:id="colStatus" text="Status" prefWidth="130" style="-fx-alignment: CENTER;"/>
                            <TableColumn fx:id="colAction" text="Action" prefWidth="90" style="-fx-alignment: CENTER;"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </VBox>

                <!-- Right: Selected Order Details Card -->
                <VBox fx:id="detailContainer" styleClass="card" style="-fx-padding: 16;" spacing="14">
                    
                    <!-- Empty State Placeholder -->
                    <VBox fx:id="emptyPlaceholder" alignment="CENTER" spacing="10" VBox.vgrow="ALWAYS">
                        <Label text="📋" style="-fx-font-size: 38px;"/>
                        <Label text="No Order Selected" styleClass="section-title" style="-fx-text-fill: #4B5563;"/>
                        <Label text="Click on any order in the table to view the full delivery address, complete itemized medicines breakdown, and fulfill or bill it in POS." 
                               textAlignment="CENTER" wrapText="true" maxWidth="320" styleClass="secondary-text"/>
                    </VBox>

                    <!-- Populated Details View -->
                    <VBox fx:id="detailsContent" spacing="12" VBox.vgrow="ALWAYS" visible="false" managed="false">
                        
                        <!-- Order Header -->
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="detailCustomerName" text="Customer Name" style="-fx-font-size: 18px; -fx-font-weight: 900; -fx-text-fill: #000000;"/>
                                    <Label fx:id="detailConfirmedBadge" text="Confirmed" styleClass="badge-success"/>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="8">
                                    <Label fx:id="detailPhone" text="Phone: 9876543210" styleClass="secondary-text"/>
                                    <Label text="•" styleClass="secondary-text"/>
                                    <Label fx:id="detailCustomerId" text="WhatsApp ID: 919876543210" styleClass="secondary-text" style="-fx-font-size: 11px;"/>
                                </HBox>
                            </VBox>
                            <Label fx:id="detailStatusBadge" text="Pending Review" styleClass="badge-warning" style="-fx-font-size: 12.5px;"/>
                        </HBox>

                        <Separator/>

                        <!-- Delivery Address Card -->
                        <VBox spacing="6" style="-fx-background-color: #F9FAFB; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10 12;">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="📍 Delivery Address &amp; Pincode" style="-fx-font-weight: 800; -fx-text-fill: #111827; -fx-font-size: 12.5px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Button fx:id="btnCopyAddress" text="📋 Copy Address" onAction="#handleCopyAddress" styleClass="button-tender" style="-fx-font-size: 11px;"/>
                            </HBox>
                            <Label fx:id="detailAddress" text="No: 123, Gandhi Road, Virudhunagar - 626001" wrapText="true" 
                                   style="-fx-font-size: 13.5px; -fx-font-weight: 700; -fx-text-fill: #000000; -fx-line-spacing: 3px;"/>
                        </VBox>

                        <!-- Medicines Breakdown -->
                        <VBox spacing="6" VBox.vgrow="ALWAYS">
                            <HBox alignment="CENTER_LEFT">
                                <Label text="Prescribed &amp; Ordered Medicines" styleClass="section-title" style="-fx-font-size: 14.5px;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label fx:id="detailItemsCount" text="0 items" styleClass="secondary-text"/>
                            </HBox>
                            
                            <TableView fx:id="detailItemsTable" prefHeight="160" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colDetailMed" text="Medicine Name" prefWidth="170"/>
                                    <TableColumn fx:id="colDetailQty" text="Qty" prefWidth="65" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colDetailUnit" text="Unit" prefWidth="75" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colDetailVol" text="Vol (ml)" prefWidth="75" style="-fx-alignment: CENTER;"/>
                                    <TableColumn fx:id="colDetailPieces" text="Pcs/Pack" prefWidth="75" style="-fx-alignment: CENTER;"/>
                                </columns>
                                <columnResizePolicy>
                                    <TableView fx:constant="UNCONSTRAINED_RESIZE_POLICY" />
                                </columnResizePolicy>
                            </TableView>
                        </VBox>

                        <!-- Workflow Status Lifecycle Bar -->
                        <VBox spacing="6" style="-fx-background-color: #F3F4F6; -fx-border-color: #E5E7EB; -fx-border-radius: 6px; -fx-background-radius: 6px; -fx-padding: 10;">
                            <Label text="Order Lifecycle &amp; Fulfillment Status" style="-fx-font-weight: 800; -fx-font-size: 11.5px; -fx-text-fill: #374151;"/>
                            <FlowPane hgap="6" vgap="6">
                                <Button fx:id="btnStatusApprove" text="✓ Approve" onAction="#handleStatusApprove" styleClass="button-outline" style="-fx-font-size: 11.5px; -fx-padding: 4 10;"/>
                                <Button fx:id="btnStatusPacking" text="📦 Start Packing" onAction="#handleStatusPacking" styleClass="button-outline" style="-fx-font-size: 11.5px; -fx-padding: 4 10;"/>
                                <Button fx:id="btnStatusShipped" text="🚚 Out for Delivery" onAction="#handleStatusShipped" styleClass="button-outline" style="-fx-font-size: 11.5px; -fx-padding: 4 10;"/>
                                <Button fx:id="btnStatusCompleted" text="🏁 Mark Delivered" onAction="#handleStatusCompleted" styleClass="button-outline" style="-fx-font-size: 11.5px; -fx-padding: 4 10;"/>
                                <Button fx:id="btnStatusCancel" text="✕ Cancel Order" onAction="#handleStatusCancel" styleClass="button-danger" style="-fx-font-size: 11.5px; -fx-padding: 4 10;"/>
                            </FlowPane>
                        </VBox>

                        <!-- Big Action: Bill in POS -->
                        <Button fx:id="btnDetailBillInPos" text="🛒 Bill in POS (Auto-fill Customer &amp; Medicines)" 
                                onAction="#handleDetailBillInPos" maxWidth="Infinity" styleClass="button-success" 
                                style="-fx-font-size: 14.5px; -fx-padding: 10 16;"/>
                    </VBox>
                </VBox>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
