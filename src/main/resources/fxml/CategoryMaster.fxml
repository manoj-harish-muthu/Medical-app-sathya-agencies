<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.CategoryController" styleClass="root" stylesheets="@../css/style.css">
    
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Category Master" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label text="Total Categories:" style="-fx-text-fill: #6B7280;"/>
                <Label fx:id="lblTotalItems" text="0" style="-fx-font-weight: bold; -fx-text-fill: #111827;"/>
            </HBox>
            
            <HBox spacing="20" VBox.vgrow="ALWAYS">
                <!-- Data Table -->
                <VBox spacing="10" HBox.hgrow="ALWAYS" styleClass="card">
                    <padding>
                        <Insets top="15" right="15" bottom="15" left="15"/>
                    </padding>
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="searchField" promptText="Search Categories..." prefWidth="250" styleClass="text-field"/>
                        <Region HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <TableView fx:id="categoryTable" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="colName" text="Category Name" prefWidth="250">
                                <cellValueFactory><PropertyValueFactory property="categoryName"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colDesc" text="Description" prefWidth="300">
                                <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                            </TableColumn>
                            <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
                
                <!-- Add/Edit Form -->
                <VBox spacing="15" styleClass="card" prefWidth="350">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>
                    
                    <Label text="Add / Edit Category" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    
                    <VBox spacing="5">
                        <Label text="Category Name *" styleClass="form-label"/>
                        <TextField fx:id="nameField" promptText="e.g. Syrup"/>
                    </VBox>
                    
                    <VBox spacing="5" VBox.vgrow="ALWAYS">
                        <Label text="Description" styleClass="form-label"/>
                        <TextArea fx:id="descriptionArea" promptText="e.g. Liquid medicine" wrapText="true" VBox.vgrow="ALWAYS"/>
                    </VBox>
                    
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Clear" onAction="#handleClear" styleClass="button-outline"/>
                        <Button text="Save Category" onAction="#handleSave" styleClass="button-primary"/>
                    </HBox>
                </VBox>
            </HBox>
            
        </VBox>
    </center>
</BorderPane>
