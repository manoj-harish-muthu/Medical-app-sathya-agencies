<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.ReportDailySalesController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Daily Sales Report" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Export PDF" styleClass="button-outline"/>
                <Button text="Export Excel" styleClass="button-outline">
                    <HBox.margin><Insets left="10"/></HBox.margin>
                </Button>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="Sales Data" styleClass="section-title"/>
                <TableView fx:id="salesTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInvoiceNo" text="Invoice No" prefWidth="150"/>
                        <TableColumn fx:id="colTime" text="Time" prefWidth="150"/>
                        <TableColumn fx:id="colCustomer" text="Customer" prefWidth="250"/>
                        <TableColumn fx:id="colTotal" text="Total" prefWidth="150"/>
                        <TableColumn fx:id="colPaymentMode" text="Payment Mode" prefWidth="150"/>
                        <TableColumn fx:id="colAction" text="Action" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
