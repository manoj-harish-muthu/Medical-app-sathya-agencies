<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.AccountCardController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="15">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Card Transactions" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <!-- Filters -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Search Filter" styleClass="form-label"/>
                    <TextField fx:id="txtSearch" promptText="Type to filter..."/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="From Date" styleClass="form-label"/>
                    <DatePicker fx:id="dpFrom" maxWidth="Infinity"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="To Date" styleClass="form-label"/>
                    <DatePicker fx:id="dpTo" maxWidth="Infinity"/>
                </VBox>
                <VBox alignment="BOTTOM_CENTER">
                    <Button text="Search" styleClass="button-primary"/>
                </VBox>
            </HBox>
            
            <TableView fx:id="tblHistory" VBox.vgrow="ALWAYS" minHeight="200">
                <columns>
                    <TableColumn text="Date / Ref" prefWidth="120">
                        <cellValueFactory><PropertyValueFactory property="date"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Entity / Name" prefWidth="250">
                        <cellValueFactory><PropertyValueFactory property="name"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Details" prefWidth="300">
                        <cellValueFactory><PropertyValueFactory property="description"/></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Value / Amount" prefWidth="150">
                        <cellValueFactory><PropertyValueFactory property="amount"/></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            
            <HBox spacing="20" alignment="CENTER_RIGHT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <Label text="Total Items/Records:" styleClass="form-label"/>
                <Label fx:id="lblTotalItems" text="0" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                <Region prefWidth="30"/>
                <Label text="Total Value (₹):" styleClass="form-label"/>
                <Label fx:id="lblGrandTotal" text="0.00" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #15803d;"/>
            </HBox>
        </VBox>
    </center>
</BorderPane>
