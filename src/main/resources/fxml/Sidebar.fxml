<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.SidebarController" styleClass="sidebar" prefWidth="250" minWidth="250" maxWidth="250">
    <padding>
        <Insets top="20" right="0" bottom="20" left="0"/>
    </padding>
    
    <VBox alignment="CENTER_LEFT" spacing="5">
        <padding>
            <Insets left="20" right="20" bottom="24"/>
        </padding>
        <Label text="Sathya Agencies" styleClass="sidebar-brand-title"/>
        <Label text="Premium Pharmacy System" styleClass="sidebar-brand-subtitle"/>
    </VBox>
    
    <ScrollPane fx:id="scrollPane" fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
        <VBox spacing="2" fx:id="menuContainer">
            <!-- Dashboard -->
            <Button text="🏠 Dashboard" onAction="#handleDashboard" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
            
            <!-- Billing / POS -->
            <VBox>
                <Button text="💰 Billing / POS" onAction="#toggleBilling" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="billingSubMenu" managed="false" visible="false">
                    <Button text="New Sale" onAction="#handlePos" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Counter Sale" onAction="#handleBillingCounterSale" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Wholesale Sale" onAction="#handleBillingWholesale" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Credit Sale" onAction="#handleBillingCreditSale" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Cash Sale" onAction="#handleBillingCashSale" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Quotation" onAction="#handleBillingQuotation" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Sales Order" onAction="#handleBillingSalesOrder" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Delivery Challan" onAction="#handleBillingDeliveryChallan" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Sales Return" onAction="#handleBillingSalesReturn" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Exchange / Replacement" onAction="#handleBillingExchange" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Hold Bills" onAction="#handleBillingHoldBills" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Suspended Bills" onAction="#handleBillingSuspendedBills" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Previous Bills" onAction="#handlePreviousBills" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Day End / Counter Closing" onAction="#handleDayEnd" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Medicines -->
            <VBox>
                <Button text="💊 Medicines" onAction="#toggleMedicines" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="medicinesSubMenu" managed="false" visible="false">
                    <Button text="Medicine Master" onAction="#handleMedicines" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Medicine Database" onAction="#handleMedDatabase" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Generic / Salt" onAction="#handleMedGenericSalt" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Brand" onAction="#handleMedBrand" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Manufacturer / Company" onAction="#handleManufacturer" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Category" onAction="#handleCategory" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Schedule H / H1 / X" onAction="#handleMedSchedule" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Substitute Medicines" onAction="#handleMedSubstitute" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Medicine Composition" onAction="#handleMedComposition" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Rack / Shelf" onAction="#handleMedRackShelf" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Barcode" onAction="#handleMedBarcode" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Batch" onAction="#handleMedBatch" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="MRP" onAction="#handleMedMRP" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Purchase Rate" onAction="#handleMedPurchaseRate" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Sale Rate" onAction="#handleMedSaleRate" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Medicine Information" onAction="#handleMedInformation" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Inventory -->
            <VBox>
                <Button text="📦 Inventory" onAction="#toggleInventory" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="inventorySubMenu" managed="false" visible="false">
                    <Button text="Current Stock" onAction="#handleInventory" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Batch-wise Stock" onAction="#handleInventoryBatchWise" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Near Expiry" onAction="#handleInventoryNearExpiry" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Purchases -->
            <VBox>
                <Button text="🛒 Purchases" onAction="#togglePurchases" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="purchasesSubMenu" managed="false" visible="false">
                    <Button text="Purchase Entry" onAction="#handlePurchases" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Purchase Orders" onAction="#handlePurchaseOrders" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Purchase Return" onAction="#handlePurchaseReturn" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Supplier Bills" onAction="#handleSupplierBills" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Purchase History" onAction="#handlePurchaseHistory" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Customers -->
            <VBox>
                <Button text="👥 Customers / Patients" onAction="#toggleCustomers" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="customersSubMenu" managed="false" visible="false">
                    <Button text="Customers" onAction="#handleCustomers" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Patients" onAction="#handlePatients" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Prescription History" onAction="#handlePrescriptionHistory" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Credit / Outstanding" onAction="#handleCreditOutstanding" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Customer Ledger" onAction="#handleCustomerLedger" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Doctors -->
            <VBox>
                <Button text="👨⚕️ Doctors" onAction="#toggleDoctors" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="doctorsSubMenu" managed="false" visible="false">
                    <Button text="Doctor Master" onAction="#handleDoctorMaster" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Prescription" onAction="#handleDoctorPrescription" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Doctor-wise Sales" onAction="#handleDoctorWiseSales" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Suppliers -->
            <VBox>
                <Button text="🏢 Suppliers" onAction="#toggleSuppliers" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="suppliersSubMenu" managed="false" visible="false">
                    <Button text="Supplier Master" onAction="#handleSupplierMaster" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Supplier Ledger" onAction="#handleSupplierLedger" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Outstanding" onAction="#handleSupplierOutstanding" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Payment" onAction="#handleSupplierPayment" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Online Orders -->
            <VBox>
                <Button text="📱 Online Orders" onAction="#toggleOnlineOrders" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="onlineOrdersSubMenu" managed="false" visible="false">
                    <Button text="Agent Orders" onAction="#handleAgentOrders" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Pending Orders" onAction="#handlePendingOrders" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Completed Orders" onAction="#handleCompletedOrders" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Failed Orders" onAction="#handleFailedOrders" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Sync Status" onAction="#handleSyncStatus" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Reports -->
            <VBox>
                <Button text="📊 Reports" onAction="#toggleReports" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="reportsSubMenu" managed="false" visible="false">
                    <Button text="Daily Sales" onAction="#handleReportDailySales" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Monthly Sales" onAction="#handleReportMonthlySales" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Purchase" onAction="#handleReportPurchase" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Stock" onAction="#handleReportStock" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Expiry" onAction="#handleReportExpiry" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Profit" onAction="#handleReportProfit" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="GST" onAction="#handleReportGST" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Customer" onAction="#handleReportCustomer" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Supplier" onAction="#handleReportSupplier" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Cashier Performance" onAction="#handleReportCashier" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Accounts -->
            <VBox>
                <Button text="💳 Accounts" onAction="#toggleAccounts" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="accountsSubMenu" managed="false" visible="false">
                    <Button text="Cash" onAction="#handleAccountCash" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="UPI" onAction="#handleAccountUPI" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Card" onAction="#handleAccountCard" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Expenses" onAction="#handleAccountExpenses" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Receivables" onAction="#handleAccountReceivables" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Payables" onAction="#handleAccountPayables" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Daily Closing" onAction="#handleAccountDailyClosing" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Alerts -->
            <VBox>
                <Button text="🔔 Alerts" onAction="#toggleAlerts" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="alertsSubMenu" managed="false" visible="false">
                    <Button text="Low Stock" onAction="#handleAlertLowStock" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Near Expiry" onAction="#handleAlertNearExpiry" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Expired" onAction="#handleAlertExpired" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Outstanding" onAction="#handleAlertOutstanding" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Pending Orders" onAction="#handleAlertPendingOrders" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Staff -->
            <VBox>
                <Button text="👨💼 Staff" onAction="#toggleStaff" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                <VBox fx:id="staffSubMenu" managed="false" visible="false">
                    <Button text="Users" onAction="#handleComingSoon" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Roles &amp; Permissions" onAction="#handleComingSoon" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Activity Log" onAction="#handleComingSoon" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                    <Button text="Login History" onAction="#handleComingSoon" styleClass="sidebar-sub-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
                </VBox>
            </VBox>

            <!-- Backup -->
            <Button text="💾 Backup" onAction="#handleComingSoon" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>

            <Button text="⚙️ Settings" onAction="#handleSettings" styleClass="sidebar-button" maxWidth="Infinity" alignment="BASELINE_LEFT"/>
        </VBox>
    </ScrollPane>

    <!-- Pinned Footer: Engineered by GuttBrains -->
    <VBox alignment="CENTER" spacing="0" style="-fx-border-color: #D1D5DB; -fx-border-width: 1 0 0 0; -fx-padding: 14 12 14 12; -fx-background-color: #FFFFFF;">
        <HBox alignment="CENTER" spacing="5">
            <Label text="Engineered by" style="-fx-font-size: 12px; -fx-text-fill: #111827; -fx-font-weight: 800;"/>
            <Hyperlink text="GuttBrains" onAction="#handleOpenGuttBrains" style="-fx-font-size: 12px; -fx-text-fill: #0D9488; -fx-font-weight: 900; -fx-padding: 0; -fx-border-width: 0; -fx-underline: false; -fx-cursor: hand;"/>
        </HBox>
    </VBox>
</VBox>
