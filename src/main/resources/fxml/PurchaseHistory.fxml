<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.PurchaseHistoryController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Purchase History" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="History" styleClass="section-title"/>
                <TableView fx:id="tblPurchaseHistory" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colInvoice" text="Invoice Number" prefWidth="150"/>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="120"/>
                        <TableColumn fx:id="colSupplier" text="Supplier" prefWidth="250"/>
                        <TableColumn fx:id="colAmount" text="Total Amount" prefWidth="150"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colPayment" text="Payment" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
