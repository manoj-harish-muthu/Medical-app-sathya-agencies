<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.ReportExpiryController" styleClass="root" stylesheets="@../css/style.css">
    
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Batch-wise Expiry Report" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Export to Excel" onAction="#handleExport" styleClass="button-primary"/>
            </HBox>
            
            <!-- Filters -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <Label text="Show Batches:" styleClass="form-label" style="-fx-font-weight: bold;"/>
                <ComboBox fx:id="timeframeCombo" prefWidth="250"/>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <!-- Legend for highlights -->
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="Legend:" style="-fx-font-weight: bold;"/>
                    <Label text=" Already Expired " style="-fx-background-color: #fee2e2; -fx-padding: 3px;"/>
                    <Label text=" Expiring Soon (&lt;1M) " style="-fx-background-color: #fef3c7; -fx-padding: 3px;"/>
                </HBox>
            </HBox>
            
            <VBox VBox.vgrow="ALWAYS" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <TableView fx:id="tblExpiry" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colMedicine" text="Medicine Name" prefWidth="250"/>
                        <TableColumn fx:id="colCompany" text="Company" prefWidth="180"/>
                        <TableColumn fx:id="colBatch" text="Batch No." prefWidth="120"/>
                        <TableColumn fx:id="colExpiryDate" text="Expiry Date" prefWidth="120"/>
                        <TableColumn fx:id="colStock" text="Current Stock" prefWidth="120"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                    </columns>
                </TableView>
            </VBox>
            
        </VBox>
    </center>
</BorderPane>
