<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.chart.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.DashboardController" styleClass="root" stylesheets="@../css/style.css">
    
    <!-- Sidebar -->
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <!-- Main Content -->
    <center>
        <VBox>
            <!-- Top Navbar -->
            <HBox alignment="CENTER_LEFT" spacing="20" styleClass="top-navbar">
                <TextField fx:id="globalSearchField" promptText="Global Search (Medicine / Bill No / Phone)..." onAction="#handleGlobalSearch" styleClass="text-field" prefWidth="340"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="alertsButton" text="🔔 Alerts" onAction="#handleShowAlerts" style="-fx-background-color: transparent; -fx-text-fill: #111827; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Label text="Main Store" styleClass="secondary-text"/>
                <Label fx:id="userNameLabel" text="Admin User" style="-fx-font-weight: bold; -fx-text-fill: #111827;"/>
                <Button text="Logout" onAction="#handleLogout" styleClass="button-outline"/>
            </HBox>
            
            <!-- Dashboard Content -->
            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                <VBox spacing="24">
                    <padding>
                        <Insets top="24" right="24" bottom="24" left="24"/>
                    </padding>
                    
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Label text="Dashboard Overview" styleClass="page-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="+ New Bill" onAction="#handlePos" styleClass="button-primary"/>
                        <Button text="📋 Previous Bills" onAction="#handlePreviousBills" styleClass="button-outline"/>
                        <Button text="💊 Medicines" onAction="#handleMedicines" styleClass="button-outline"/>
                        <Button text="📦 Inventory" onAction="#handleInventory" styleClass="button-outline"/>
                        <Button text="🤖 Agent Orders" onAction="#handleAgentOrders" styleClass="button-outline"/>
                    </HBox>
                    
                    <!-- KPI Cards Row -->
                    <HBox spacing="24">
                        <VBox onMouseClicked="#handleSalesKpi" styleClass="card" HBox.hgrow="ALWAYS" spacing="10" style="-fx-cursor: hand;">
                            <Label text="Today's Sales" styleClass="secondary-text"/>
                            <Label fx:id="salesLabel" text="₹ 0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label text="View sales report →" style="-fx-text-fill: #16A34A; -fx-font-size: 12px;"/>
                        </VBox>
                        
                        <VBox onMouseClicked="#handleBillsKpi" styleClass="card" HBox.hgrow="ALWAYS" spacing="10" style="-fx-cursor: hand;">
                            <Label text="Today's Bills" styleClass="secondary-text"/>
                            <Label fx:id="billsLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #111827;"/>
                            <Label text="View all bills →" style="-fx-text-fill: #16A34A; -fx-font-size: 12px;"/>
                        </VBox>
                        
                        <VBox onMouseClicked="#handleLowStockKpi" styleClass="card" HBox.hgrow="ALWAYS" spacing="10" style="-fx-cursor: hand;">
                            <Label text="Low Stock Items" styleClass="secondary-text"/>
                            <Label fx:id="lowStockLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                            <Label text="Requires attention →" style="-fx-text-fill: #F59E0B; -fx-font-size: 12px;"/>
                        </VBox>
                        
                        <VBox onMouseClicked="#handleExpiringKpi" styleClass="card" HBox.hgrow="ALWAYS" spacing="10" style="-fx-cursor: hand;">
                            <Label text="Expiring Soon" styleClass="secondary-text"/>
                            <Label fx:id="expiringLabel" text="0" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                            <Label text="Within 90 days →" style="-fx-text-fill: #F59E0B; -fx-font-size: 12px;"/>
                        </VBox>
                    </HBox>
                    
                    <!-- Main Content Area -->
                    <HBox spacing="24">
                        <!-- Chart Placeholder -->
                        <VBox styleClass="card" HBox.hgrow="ALWAYS" prefHeight="300" spacing="15">
                            <Label text="Sales Trend" styleClass="section-title"/>
                            <StackPane VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                                <LineChart fx:id="salesTrendChart" legendVisible="false">
                                    <xAxis>
                                        <CategoryAxis side="BOTTOM" fx:id="xAxis" />
                                    </xAxis>
                                    <yAxis>
                                        <NumberAxis side="LEFT" fx:id="yAxis" />
                                    </yAxis>
                                </LineChart>
                            </StackPane>
                        </VBox>
                        
                        <!-- Recent Activity -->
                        <VBox styleClass="card" prefWidth="350" spacing="15">
                            <Label text="Recent Bills" styleClass="section-title"/>
                            <VBox fx:id="recentBillsContainer" spacing="10" VBox.vgrow="ALWAYS">
                                <!-- Dynamic recent bills will be loaded here -->
                            </VBox>
                            <Button text="View All" onAction="#handlePreviousBills" styleClass="button-outline" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>
            </ScrollPane>
        </VBox>
    </center>

</BorderPane>
