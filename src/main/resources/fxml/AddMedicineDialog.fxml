<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.AddMedicineController" stylesheets="@../css/style.css" style="-fx-background-color: #F8FAFC; -fx-padding: 20px;" spacing="20">
    
    <!-- Header -->
    <Label text="Add Product" styleClass="page-title"/>
    
    <VBox spacing="15" styleClass="card">
        
        <!-- Top Section Grid -->
        <GridPane hgap="10" vgap="5">
            <Label text="STATUS" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <ComboBox fx:id="statusCombo" GridPane.columnIndex="2" GridPane.rowIndex="0" prefWidth="100"/>
            
            <Label text="TYPE" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
            <ComboBox fx:id="typeCombo" GridPane.columnIndex="5" GridPane.rowIndex="0" prefWidth="100"/>
            
            <Label text="HIDE" GridPane.columnIndex="6" GridPane.rowIndex="0"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="0"/>
            <ComboBox fx:id="hideCombo" GridPane.columnIndex="8" GridPane.rowIndex="0" prefWidth="60"/>

            <Label text="PRODUCT" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <TextField fx:id="nameField" GridPane.columnIndex="2" GridPane.rowIndex="1" GridPane.columnSpan="4" prefWidth="300" />
            
            <Label text="PACKING" GridPane.columnIndex="6" GridPane.rowIndex="1"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="1"/>
            <TextField fx:id="packingField" GridPane.columnIndex="8" GridPane.rowIndex="1" prefWidth="100"/>

            <Label text="UNIT 1st" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <TextField fx:id="unit1stField" GridPane.columnIndex="2" GridPane.rowIndex="2" prefWidth="100"/>
            
            <Label text="UNIT 2nd" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
            <TextField fx:id="unit2ndField" GridPane.columnIndex="5" GridPane.rowIndex="2" prefWidth="100"/>
            
            <Label text="DECIMAL" GridPane.columnIndex="6" GridPane.rowIndex="2"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="2"/>
            <ComboBox fx:id="decimalCombo" GridPane.columnIndex="8" GridPane.rowIndex="2" prefWidth="60"/>

            <Label text="COLOR TYPE" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <ComboBox fx:id="colorTypeCombo" GridPane.columnIndex="2" GridPane.rowIndex="3" prefWidth="100"/>
            
            <Label text="ITEM TYPE" GridPane.columnIndex="6" GridPane.rowIndex="3"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="3"/>
            <ComboBox fx:id="itemTypeCombo" GridPane.columnIndex="8" GridPane.rowIndex="3" prefWidth="100"/>

            <Label text="COMPANY" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <TextField fx:id="companyField" GridPane.columnIndex="2" GridPane.rowIndex="4" GridPane.columnSpan="4" prefWidth="300"/>

            <Label text="SALT" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="5"/>
            <TextField fx:id="saltField" GridPane.columnIndex="2" GridPane.rowIndex="5" GridPane.columnSpan="7" prefWidth="450"/>

            <Label text="HSN/SAC" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="6"/>
            <TextField fx:id="hsnField" GridPane.columnIndex="2" GridPane.rowIndex="6" prefWidth="100"/>
            
            <Label text="ERP2ERP (BATCH)" GridPane.columnIndex="6" GridPane.rowIndex="6"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="6"/>
            <TextField fx:id="batchField" GridPane.columnIndex="8" GridPane.rowIndex="6" prefWidth="100"/>
            
            <Label text="EXPIRY DATE" GridPane.columnIndex="0" GridPane.rowIndex="7"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="7"/>
            <DatePicker fx:id="expiryDatePicker" GridPane.columnIndex="2" GridPane.rowIndex="7" prefWidth="150"/>
            
            <Label text="QUANTITY" GridPane.columnIndex="3" GridPane.rowIndex="7"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="7"/>
            <TextField fx:id="quantityField" GridPane.columnIndex="5" GridPane.rowIndex="7" prefWidth="100"/>
        </GridPane>
        
        <Separator />

        <!-- Bottom Section Grid -->
        <GridPane hgap="15" vgap="5">
            <!-- Column 1 -->
            <Label text="LOCAL" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
            <ComboBox fx:id="localTaxCombo" GridPane.columnIndex="2" GridPane.rowIndex="0" prefWidth="100"/>

            <Label text="CENTRAL" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
            <ComboBox fx:id="centralTaxCombo" GridPane.columnIndex="2" GridPane.rowIndex="1" prefWidth="100"/>

            <Label text="M.R.P." GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
            <TextField fx:id="mrpField" GridPane.columnIndex="2" GridPane.rowIndex="2" prefWidth="100" alignment="CENTER_RIGHT"/>

            <Label text="Rate-A" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
            <TextField fx:id="rateAField" GridPane.columnIndex="2" GridPane.rowIndex="3" prefWidth="100" alignment="CENTER_RIGHT"/>

            <Label text="CONV.STR" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <Label text=":" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            <TextField fx:id="convStrField" GridPane.columnIndex="2" GridPane.rowIndex="4" prefWidth="100" alignment="CENTER_RIGHT"/>

            <!-- Column 2 -->
            <Label text="SGST %" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
            <TextField fx:id="sgstField" GridPane.columnIndex="5" GridPane.rowIndex="0" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="IGST %" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="1"/>
            <TextField fx:id="igstField" GridPane.columnIndex="5" GridPane.rowIndex="1" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="P.RATE" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="2"/>
            <TextField fx:id="purchaseRateField" GridPane.columnIndex="5" GridPane.rowIndex="2" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="Rate-B" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="3"/>
            <TextField fx:id="rateBField" GridPane.columnIndex="5" GridPane.rowIndex="3" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="CONV.CAS" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
            <Label text=":" GridPane.columnIndex="4" GridPane.rowIndex="4"/>
            <TextField fx:id="convCasField" GridPane.columnIndex="5" GridPane.rowIndex="4" prefWidth="80" alignment="CENTER_RIGHT"/>

            <!-- Column 3 -->
            <Label text="CGST %" GridPane.columnIndex="6" GridPane.rowIndex="0"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="0"/>
            <TextField fx:id="cgstField" GridPane.columnIndex="8" GridPane.rowIndex="0" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="COST/PCS" GridPane.columnIndex="6" GridPane.rowIndex="2"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="2"/>
            <TextField fx:id="costPcsField" GridPane.columnIndex="8" GridPane.rowIndex="2" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="Rate-C" GridPane.columnIndex="6" GridPane.rowIndex="3"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="3"/>
            <TextField fx:id="rateCField" GridPane.columnIndex="8" GridPane.rowIndex="3" prefWidth="80" alignment="CENTER_RIGHT"/>

            <Label text="NEGATIVE" GridPane.columnIndex="6" GridPane.rowIndex="4"/>
            <Label text=":" GridPane.columnIndex="7" GridPane.rowIndex="4"/>
            <ComboBox fx:id="negativeCombo" GridPane.columnIndex="8" GridPane.rowIndex="4" prefWidth="80"/>
        </GridPane>
        
        <Label fx:id="errorLabel" styleClass="error-label"/>
        
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Button text="Cancel" onAction="#handleCancel" styleClass="button-outline"/>
            <Button text="Save Product" onAction="#handleSave" styleClass="button-primary"/>
        </HBox>
    </VBox>
</VBox>
