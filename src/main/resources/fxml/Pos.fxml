<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.PosController" styleClass="root" stylesheets="@../css/style.css">
    
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="20" bottom="15" left="20"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="New Sale (POS)" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="dateLabel" style="-fx-font-weight: bold; -fx-text-fill: #4B5563; -fx-font-size: 14px;"/>
                <Button text="Dashboard" onAction="#handleDashboard" styleClass="button-outline"/>
            </HBox>
            
            <!-- Customer Details -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Customer Phone (F2)" styleClass="form-label"/>
                    <TextField fx:id="customerPhoneField" promptText="Enter Mobile Number"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Customer Name" styleClass="form-label"/>
                    <TextField fx:id="customerNameField" promptText="Enter Customer Name"/>
                </VBox>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Doctor Name" styleClass="form-label"/>
                    <TextField fx:id="doctorNameField" promptText="Doctor Name (Optional)"/>
                </VBox>
            </HBox>
            
            <!-- Medicine Search -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Search Medicine / Scan Barcode (F1)" styleClass="form-label"/>
                    <TextField fx:id="medicineSearchField" promptText="Search by Name or Barcode..." style="-fx-font-size: 16px; -fx-background-color: #e6f2e6;"/>
                </VBox>
            </HBox>
            
            <!-- Cart Table -->
            <TableView fx:id="cartTable" VBox.vgrow="ALWAYS" minHeight="200" editable="true">
                <columns>
                    <TableColumn fx:id="colItem" text="Medicine" prefWidth="200"/>
                    <TableColumn fx:id="colPack" text="Pack" prefWidth="80"/>
                    <TableColumn fx:id="colMfr" text="Mfr" prefWidth="120"/>
                    <TableColumn fx:id="colHsn" text="HSN" prefWidth="80"/>
                    <TableColumn fx:id="colBatch" text="Batch" prefWidth="100"/>
                    <TableColumn fx:id="colExp" text="Exp" prefWidth="80"/>
                    <TableColumn fx:id="colQty" text="Qty" prefWidth="60"/>
                    <TableColumn fx:id="colMrp" text="MRP" prefWidth="80"/>
                    <TableColumn fx:id="colRate" text="Rate" prefWidth="80"/>
                    <TableColumn fx:id="colDisc" text="Disc%" prefWidth="60"/>
                    <TableColumn fx:id="colGst" text="GST%" prefWidth="60"/>
                    <TableColumn fx:id="colAmount" text="Net Amt" prefWidth="100"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="80"/>
                </columns>
            </TableView>
            
            <!-- Totals & Actions -->
            <HBox spacing="20" alignment="CENTER_RIGHT" styleClass="card" style="-fx-background-color: #f0f7f4;">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                
                <VBox spacing="10">
                    <Label fx:id="itemsCountLabel" text="0 items in cart" style="-fx-font-weight: bold;"/>
                    <HBox spacing="10">
                        <Label text="Subtotal: "/>
                        <Label fx:id="subtotalLabel" text="₹ 0.00" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Discount: "/>
                        <Label fx:id="discountLabel" text="₹ 0.00" style="-fx-font-weight: bold;"/>
                    </HBox>
                    <HBox spacing="10">
                        <Label text="Tax: "/>
                        <Label fx:id="taxLabel" text="₹ 0.00" style="-fx-font-weight: bold;"/>
                    </HBox>
                </VBox>
                
                <Region HBox.hgrow="ALWAYS"/>
                
                <VBox spacing="10" alignment="CENTER_RIGHT">
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Label text="Grand Total:" styleClass="form-label"/>
                        <Label fx:id="totalLabel" text="₹ 0.00" style="-fx-font-weight: bold; -fx-font-size: 24px; -fx-text-fill: #15803d;"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Label text="Paid Amount:"/>
                        <TextField fx:id="paidAmountField" promptText="0.00" prefWidth="100"/>
                    </HBox>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Label text="Balance / Change:"/>
                        <Label fx:id="balanceLabel" text="₹ 0.00" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                    </HBox>
                </VBox>
                
                <Region prefWidth="30"/>
                
                <VBox spacing="10">
                    <ComboBox fx:id="paymentModeCombo" prefWidth="150"/>
                    <Button text="Clear Bill (F3)" styleClass="button-outline" onAction="#handleClearBill" prefWidth="150"/>
                    <Button text="Hold Bill" styleClass="button-outline" onAction="#handleSuspendBill" prefWidth="150"/>
                    <Button text="Complete Sale (F12)" styleClass="button-primary" onAction="#handleCompleteSale" prefHeight="40" prefWidth="150" style="-fx-font-size: 14px;"/>
                </VBox>
            </HBox>
            
        </VBox>
    </center>
</BorderPane>
