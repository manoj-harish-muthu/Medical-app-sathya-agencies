<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.DayEndClosingController" styleClass="root" stylesheets="@../css/style.css">
    
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #FFFFFF; -fx-border-color: #E2E8F0; -fx-border-width: 0 0 1 0; -fx-padding: 15 24;">
            <Button text="← Back to Dashboard" onAction="#handleDashboard" styleClass="button-outline"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Day End / Counter Closing" styleClass="section-title"/>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>

    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>

    <center>
        <VBox spacing="20" alignment="TOP_CENTER">
            <padding>
                <Insets top="40" right="40" bottom="40" left="40"/>
            </padding>
            
            <VBox spacing="20" styleClass="card" maxWidth="600" alignment="CENTER">
                <padding>
                    <Insets top="30" right="30" bottom="30" left="30"/>
                </padding>
                <Label text="Daily Sales Summary" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                <HBox alignment="CENTER" spacing="10">
                    <Label text="Date: " style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="datePicker" styleClass="text-field" onAction="#loadSummary"/>
                </HBox>
                
                <Separator/>
                
                <GridPane hgap="40" vgap="15" alignment="CENTER">
                    <Label text="Total Invoices:" GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-font-size: 16px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="lblInvoices" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    
                    <Label text="Cash Sales:" GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-font-size: 16px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="lblCash" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #16A34A;"/>
                    
                    <Label text="UPI Sales:" GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-font-size: 16px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="lblUpi" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2563EB;"/>
                    
                    <Label text="Card Sales:" GridPane.columnIndex="0" GridPane.rowIndex="3" style="-fx-font-size: 16px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="lblCard" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #D97706;"/>
                    
                    <Label text="Credit Sales:" GridPane.columnIndex="0" GridPane.rowIndex="4" style="-fx-font-size: 16px; -fx-text-fill: #64748B;"/>
                    <Label fx:id="lblCredit" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="4" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #DC2626;"/>
                </GridPane>
                
                <Separator/>
                
                <HBox alignment="CENTER" spacing="40">
                    <Label text="Grand Total:" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
                    <Label fx:id="lblTotal" text="₹ 0.00" style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #16A6A1;"/>
                </HBox>
                
                <Button text="Print Z-Report (Day End Close)" onAction="#handlePrint" styleClass="button-primary" prefWidth="300" style="-fx-font-size: 16px; -fx-padding: 10 20;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>
