<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.DayEndClosingController" styleClass="root" stylesheets="@../css/style.css">
    
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="20" right="30" bottom="20" left="30"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label text="Day End / Counter Closing" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Print Z-Report" onAction="#handlePrint" styleClass="button-primary"/>
            </HBox>
            
            <!-- Filter -->
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <Label text="Select Date:" styleClass="form-label" style="-fx-font-weight: bold;"/>
                <DatePicker fx:id="datePicker" onAction="#loadSummary"/>
            </HBox>
            
            <!-- Summary Grid -->
            <GridPane hgap="20" vgap="20" styleClass="card">
                <padding>
                    <Insets top="20" right="20" bottom="20" left="20"/>
                </padding>
                <columnConstraints>
                    <ColumnConstraints minWidth="150" halignment="LEFT"/>
                    <ColumnConstraints minWidth="150" halignment="RIGHT"/>
                </columnConstraints>
                
                <Label text="Total Invoices:" GridPane.columnIndex="0" GridPane.rowIndex="0" styleClass="form-label"/>
                <Label fx:id="lblInvoices" text="0" GridPane.columnIndex="1" GridPane.rowIndex="0" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <Label text="Cash Sales:" GridPane.columnIndex="0" GridPane.rowIndex="1" styleClass="form-label"/>
                <Label fx:id="lblCash" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="1" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <Label text="UPI Sales:" GridPane.columnIndex="0" GridPane.rowIndex="2" styleClass="form-label"/>
                <Label fx:id="lblUpi" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="2" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <Label text="Card Sales:" GridPane.columnIndex="0" GridPane.rowIndex="3" styleClass="form-label"/>
                <Label fx:id="lblCard" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="3" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <Label text="Credit Sales:" GridPane.columnIndex="0" GridPane.rowIndex="4" styleClass="form-label"/>
                <Label fx:id="lblCredit" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="4" style="-fx-font-weight: bold; -fx-font-size: 16px;"/>
                
                <Separator GridPane.columnIndex="0" GridPane.rowIndex="5" GridPane.columnSpan="2"/>
                
                <Label text="Grand Total Sales:" GridPane.columnIndex="0" GridPane.rowIndex="6" styleClass="form-label" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
                <Label fx:id="lblTotal" text="₹ 0.00" GridPane.columnIndex="1" GridPane.rowIndex="6" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #15803d;"/>
                
            </GridPane>
            
        </VBox>
    </center>
</BorderPane>
