<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.cell.PropertyValueFactory?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.PurchaseController" styleClass="root" stylesheets="@../css/style.css">
    
    <!-- Sidebar -->
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    
    <!-- Main Content -->
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            
            <HBox alignment="CENTER_LEFT">
                <Label text="Purchase Management" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ New Purchase Order" styleClass="button-primary"/>
                <Button text="+ New GRN" styleClass="button-outline">
                    <HBox.margin><Insets left="10"/></HBox.margin>
                </Button>
            </HBox>
            
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="Recent Purchases" styleClass="section-title"/>
                
                <TableView VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Invoice Number" prefWidth="150"/>
                        <TableColumn text="Date" prefWidth="120"/>
                        <TableColumn text="Supplier" prefWidth="250"/>
                        <TableColumn text="Total Amount" prefWidth="150"/>
                        <TableColumn text="Status" prefWidth="100"/>
                        <TableColumn text="Payment" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
