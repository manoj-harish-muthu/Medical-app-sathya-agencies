<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.SupplierBillsController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Supplier Bills" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox spacing="15" alignment="CENTER_LEFT" styleClass="card">
                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>
                <Label text="Select Supplier:" styleClass="form-label"/>
                <ComboBox fx:id="cmbSupplier" prefWidth="300" promptText="-- Select Supplier --"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="Supplier Bills History" styleClass="section-title"/>
                <TableView fx:id="tblBills" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colBillNo" text="Bill/Invoice No" prefWidth="150"/>
                        <TableColumn fx:id="colDate" text="Date" prefWidth="150"/>
                        <TableColumn fx:id="colTotal" text="Total Amount" prefWidth="150"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="120"/>
                        <TableColumn fx:id="colAction" text="Action" prefWidth="100"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
