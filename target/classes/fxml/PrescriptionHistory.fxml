<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.PrescriptionHistoryController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Prescription History" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="History" styleClass="section-title"/>
                <TableView VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Date" prefWidth="120"/>
                        <TableColumn text="Patient Name" prefWidth="200"/>
                        <TableColumn text="Doctor Name" prefWidth="200"/>
                        <TableColumn text="Medicines" prefWidth="300"/>
                        <TableColumn text="Notes" prefWidth="200"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
