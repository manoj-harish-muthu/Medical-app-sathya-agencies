<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.AccountExpensesController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Expenses" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Add Expense" styleClass="button-primary"/>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="Expense Ledger" styleClass="section-title"/>
                <TableView VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Date" prefWidth="120"/>
                        <TableColumn text="Category" prefWidth="150"/>
                        <TableColumn text="Description" prefWidth="250"/>
                        <TableColumn text="Amount" prefWidth="150"/>
                        <TableColumn text="Payment Mode" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
