<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.pharmacyerp.controller.ReportCashierController" styleClass="root" stylesheets="@../css/style.css">
    <left>
        <fx:include source="Sidebar.fxml"/>
    </left>
    <center>
        <VBox spacing="20">
            <padding>
                <Insets top="24" right="24" bottom="24" left="24"/>
            </padding>
            <HBox alignment="CENTER_LEFT">
                <Label text="Cashier Performance Report" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Export PDF" styleClass="button-outline"/>
                <Button text="Export Excel" styleClass="button-outline">
                    <HBox.margin><Insets left="10"/></HBox.margin>
                </Button>
            </HBox>
            <VBox styleClass="card" VBox.vgrow="ALWAYS" spacing="15">
                <Label text="Cashier Metrics" styleClass="section-title"/>
                <TableView VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn text="Cashier Name" prefWidth="200"/>
                        <TableColumn text="Bills Generated" prefWidth="150"/>
                        <TableColumn text="Total Value" prefWidth="150"/>
                        <TableColumn text="Cash Collected" prefWidth="150"/>
                        <TableColumn text="Digital Collected" prefWidth="150"/>
                    </columns>
                </TableView>
            </VBox>
        </VBox>
    </center>
</BorderPane>
